APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Crypto Vault
# ---------------------------------------------------------------------------
# 32-byte base64 key used to encrypt vault secrets (HD seed, hot wallet keys,
# exchange API keys). Generate with: php artisan vault:key
# NEVER commit the real value and keep an offline backup.
VAULT_MASTER_KEY=
VAULT_KEY_PROVIDER=env
VAULT_SEED_NAME=hd_seed_mainnet
VAULT_SEED_PASSPHRASE=

# Withdrawal policy (overridable at runtime from the admin settings page)
WITHDRAWAL_REQUIRE_2FA=true
WITHDRAWAL_AUTO_ENABLED=true

# Binance spot (use testnet.binance.vision for staging)
BINANCE_TESTNET=false
BINANCE_BASE_URL=https://api.binance.com

# Blockchain endpoints — replace with private RPC providers in production.
BTC_ENABLED=false
BTC_API_URL=https://mempool.space/api
BTC_CONFIRMATIONS=3
BTC_TESTNET=false

ETH_ENABLED=false
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

BSC_ENABLED=false
BSC_RPC_URL=https://bsc-rpc.publicnode.com

POLYGON_ENABLED=false
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

TRON_ENABLED=false
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=

SCAN_MAX_BLOCKS_PER_RUN=300
SCAN_REORG_SAFETY_BLOCKS=5

# Laravel Reverb (websockets)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
